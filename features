from itertools import product
import re

from Bio.Seq import Seq
from Bio.SeqUtils import CodonAdaptationIndex, gc_fraction


# =========================================================
# 1. K-MER FREQUENCY ANALYSIS (k = 3, 4)
# =========================================================

def get_kmer_frequencies(sequence: str, k: int) -> dict:
    """
    Count every possible k-length DNA "word" (k-mer) in the sequence
    and return its normalized frequency (0-1).

    e.g. get_kmer_frequencies("ATGCGT", 3)
         -> {'AAA': 0.0, 'AAC': 0.0, ..., 'ATG': 0.25, 'TGC': 0.25, ...}
    """
    sequence = sequence.upper().replace("\n", "")
    all_kmers = ["".join(p) for p in product("ACGT", repeat=k)]
    counts = dict.fromkeys(all_kmers, 0)

    total = 0
    for i in range(len(sequence) - k + 1):
        kmer = sequence[i:i + k]
        if kmer in counts:          # skip windows with N or other ambiguity codes
            counts[kmer] += 1
            total += 1

    if total == 0:
        return {kmer: 0.0 for kmer in all_kmers}
    return {kmer: count / total for kmer, count in counts.items()}


# =========================================================
# 2. CODON ADAPTATION INDEX (CAI)
# =========================================================

def build_cai_index(reference_sequences: list, table=None) -> CodonAdaptationIndex:
    """
    Build a CAI reference table from a list of known, highly-expressed
    coding sequences (CDS) for your target host organism
    (e.g. a curated set of native, highly-expressed E. coli genes).

    Do this ONCE per organism and reuse the returned object —
    don't rebuild it for every sequence you score.
    """
    if table is not None:
        return CodonAdaptationIndex(reference_sequences, table=table)
    return CodonAdaptationIndex(reference_sequences)


def calculate_cai(sequence: str, cai_index: CodonAdaptationIndex) -> float:
    """
    Score how strongly a sequence sticks to the "preferred" codons of the
    reference organism. Natural genes show natural variation (lower/mixed
    CAI); AI-optimized or lab-synthesized genes are often suspiciously
    close to 1.0 ("too perfect").
    """
    sequence = sequence.upper().replace("\n", "")
    trimmed_len = len(sequence) - (len(sequence) % 3)   # CAI needs whole codons
    sequence = sequence[:trimmed_len]

    try:
        return cai_index.calculate(sequence)
    except Exception:
        return None  # e.g. sequence too short, or contains a stop mid-frame


# =========================================================
# 3. GC SKEW + GC CONTENT
# =========================================================

def calculate_gc_skew(sequence: str, window_size: int = 100, step: int = 50) -> list:
    """
    Slide a window across the sequence and compute GC skew = (G-C)/(G+C)
    in each window. Natural genomes show smooth, biologically-explainable
    skew trends; lab-stitched constructs often show abrupt jumps at the
    seams where fragments were joined.
    """
    sequence = sequence.upper().replace("\n", "")
    results = []
    for i in range(0, max(len(sequence) - window_size + 1, 1), step):
        window = sequence[i:i + window_size]
        g, c = window.count("G"), window.count("C")
        skew = 0.0 if (g + c) == 0 else (g - c) / (g + c)
        results.append({"start": i, "end": i + len(window), "gc_skew": skew})
    return results


def overall_gc_content(sequence: str) -> float:
    """Overall %GC of the whole sequence."""
    sequence = sequence.upper().replace("\n", "")
    return gc_fraction(Seq(sequence)) * 100


# =========================================================
# 4. RESTRICTION SCAR / ASSEMBLY-JUNCTION PATTERN MATCHING
# =========================================================

# Common Type IIS enzymes used in Golden Gate / MoClo cloning, whose
# recognition sites often leave a short leftover "scar" at assembly
# junctions. Extend this list with whatever your dataset's ground truth
# constructs actually use.
COMMON_SCAR_MOTIFS = {
    "BsaI":  "GGTCTC",
    "BsmBI": "CGTCTC",
    "BbsI":  "GAAGAC",
    "SapI":  "GCTCTTC",
    "AarI":  "CACCTGC",
}


def find_restriction_scars(sequence: str, motif_dict: dict = None) -> list:
    """
    Search for known enzyme/scar motifs (and their reverse complements,
    since enzymes cut double-stranded DNA) and report every hit position.
    """
    sequence = sequence.upper().replace("\n", "")
    motif_dict = motif_dict or COMMON_SCAR_MOTIFS
    hits = []

    for name, motif in motif_dict.items():
        rev_comp = str(Seq(motif).reverse_complement())
        for pattern, strand in [(motif, "+"), (rev_comp, "-")]:
            for m in re.finditer(pattern, sequence):
                hits.append({
                    "enzyme_or_scar": name,
                    "motif": pattern,
                    "strand": strand,
                    "start": m.start(),
                    "end": m.end(),
                })
    return hits


# =========================================================
# COMBINE EVERYTHING INTO ONE FEATURE VECTOR
# =========================================================

def extract_all_features(sequence: str, cai_index: CodonAdaptationIndex = None) -> dict:
    """
    The single entry point the ML teammate should call.
    Returns one dict per sequence — this is the row that gets fed
    into the anomaly-detection model.
    """
    features = {
        "kmer_3": get_kmer_frequencies(sequence, 3),
        "kmer_4": get_kmer_frequencies(sequence, 4),
        "gc_content": overall_gc_content(sequence),
        "gc_skew_windows": calculate_gc_skew(sequence),
        "restriction_scars": find_restriction_scars(sequence),
    }
    if cai_index is not None:
        features["cai"] = calculate_cai(sequence, cai_index)
    else:
        features["cai"] = None
    return features


